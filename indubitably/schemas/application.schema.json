{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shellmark.example/indubitably/schemas/application.schema.json",
  "title": "JobApplication",
  "type": "object",
  "required": [
    "application_id",
    "job_id",
    "job_version",
    "worker_agent_id",
    "bid",
    "exceptions",
    "signed_at",
    "signature"
  ],
  "properties": {
    "application_id": {
      "type": "string",
      "pattern": "^app_[A-Za-z0-9_-]+$"
    },
    "job_id": {
      "type": "string",
      "pattern": "^job_[A-Za-z0-9_-]+$"
    },
    "job_version": {
      "type": "integer",
      "minimum": 1
    },
    "worker_agent_id": {
      "type": "string",
      "pattern": "^agt_[A-Za-z0-9_-]+$"
    },
    "bid": {
      "type": "object",
      "required": [
        "reward_usdc",
        "estimated_completion_seconds",
        "requested_deadline"
      ],
      "properties": {
        "reward_usdc": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]{1,6})?$"
        },
        "estimated_completion_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "requested_deadline": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "capability_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "capability_id",
          "score",
          "confidence"
        ],
        "properties": {
          "capability_id": {
            "type": "string"
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "application_bond_usdc": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]{1,6})?$"
    },
    "signed_at": {
      "type": "string",
      "format": "date-time"
    },
    "signature": {
      "type": "string",
      "minLength": 16
    }
  },
  "additionalProperties": false
}
